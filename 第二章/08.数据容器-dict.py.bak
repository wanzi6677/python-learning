print("欢迎使用教务管理系统！\n")
print("#########                                   【菜单】                                            #########")
print("#       1.添加学生信息  2.修改学生信息  3.删除学生信息  4.查询学生信息  5.列出所有学生  6.统计班级成绩  7.退出系统      #")
print("########################################################################################################")


student = dict()

while(True):
    print("#########                                   【菜单】                                            #########")
    print(
        "#       1.添加学生信息  2.修改学生信息  3.删除学生信息  4.查询学生信息  5.列出所有学生  6.统计班级成绩  7.退出系统      #")
    print("########################################################################################################")
    num = input("请选择要执行的操作(1-7):")
    match num:
        case "1":
            students_name = input("请输入学生名称：")
            student_ch = float(input("请输入语文成绩："))
            student_ma = float(input("请输入数学成绩："))
            student_en = float(input("请输入数学成绩："))
            if(students_name in student):
                print("学生已存在，请重新选择")
            else:
                student[students_name] = {"语文": student_ch, "数学": student_ma, "英语": student_en}
                print(f"添加{students_name}完毕")
        case "2":
            students_name = input("请输入要修改的学生名称：")
            student_ch = float(input("请输入最新的语文成绩："))
            student_ma = float(input("请输入最新的数学成绩："))
            student_en = float(input("请输入最新的英语成绩："))
            if (students_name in student):
                print("学生已存在，请重新选择")
            else:
                student[students_name] = {"语文": student_ch, "数学": student_ma, "英语": student_en}
                print(f"添加{students_name}完毕")


        case "3":
            students_name = input("请输入要删除的学生姓名：")
            del student[students_name]
            print(f"删除{students_name}完毕")

        case "4":
            students_name = input("请输入要查询的学生姓名：")
            print(f"{students_name}的信息是{student.get(students_name)}")

        case "5":
            print(f"所有学生的信息情况是{student.items()}")
        case "6":
            if not student:
                print("暂无学生信息，请先添加学生")
            else:
                # 统计三科的最高分、最低分
                for subject in ["语文", "数学", "英语"]:
                    max_name = max(student, key=lambda name: student[name][subject])
                    min_name = min(student, key=lambda name: student[name][subject])
                    print(f"{subject} 最高分：{student[max_name][subject]}（{max_name}）")
                    print(f"{subject} 最低分：{student[min_name][subject]}（{min_name}）")

                # 统计三科平均分
                for subject in ["语文", "数学", "英语"]:
                    avg = sum(student[name][subject] for name in student) / len(student)
                    print(f"{subject} 平均分：{avg:.2f}")
        case "7":
            print("已经成功退出，欢迎下次使用！！")
            break
        case _:
            print("非法操作不支持")



